import pygame
pygame.init()

# НАЛАШТУВАННЯ ФОНУ
WIDTH, HEIGHT = 1280, 720
screen = pygame.display.set_mode((WIDTH, HEIGHT))
clock = pygame.time.Clock()

# Цей класс дає можливість створити в грі будь-який об'єкт.
class GameObject():
    def __init__(self, filename, x=0, y=0, width=10, height=10):
        self.image = pygame.image.load(filename)
        self.image = pygame.transform.scale(self.image, (width, height))
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

    def draw(self):
        screen.blit(self.image, self.rect)

# Це приклад як робити будь-який об'єкт
#                    це текстура   х кор.     у кор.    розмір по ширині - висоті
player = GameObject("player.png", 0, 0, 230, 230)

start = True
while start:
    screen.fill("white")
    player.draw()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            start = False


    pygame.display.flip()
    clock.tick(100)
pygame.quit()
