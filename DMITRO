import pygame

pygame.init()
pygame.font.init()

WIDTH, HEIGHT = 1280, 720
screen = pygame.display.set_mode((WIDTH, HEIGHT))
background = pygame.image.load("background.jpg")
background = pygame.transform.scale(background, (WIDTH, HEIGHT))
clock = pygame.time.Clock()

# НАЛАШТУВАННЯ В ГРІ.
GRAVITY = 1
JUMP_POWER = -20
GROUND_Y = 434

# Шрифт для відображення HP
font = pygame.font.SysFont("Arial", 36, bold=True)

class GameObject():
    def __init__(self, filename, x=0, y=0, width=10, height=10):
        self.image_right = pygame.image.load(filename)
        self.image_right = pygame.transform.scale(self.image_right, (width, height))
        self.image_left = pygame.transform.flip(self.image_right, True, False)
        self.image = self.image_right
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.facing_right = True
        self.velocity_y = 0
        self.isJumping = False
        
        # Бойові характеристики
        self.hp = 100
        self.can_hit = True

    def draw(self):
        screen.blit(self.image, self.rect)

    def move(self, dx):
        self.rect.x += dx
        if dx > 0:
            self.image = self.image_right
            self.facing_right = True
        if dx < 0:
            self.image = self.image_left
            self.facing_right = False

    def apply_gravity(self):
        self.velocity_y += GRAVITY
        self.rect.y += self.velocity_y
        if self.rect.y >= GROUND_Y:
            self.rect.y = GROUND_Y
            self.velocity_y = 0
            self.isJumping = False

    def jump(self):
        if not self.isJumping:
            self.velocity_y = JUMP_POWER
            self.isJumping = True

player_x = 0
player_y = 300
player_forward = 0
player = GameObject("player1.png", player_x, player_y, 120, 170)

player_x2 = 1160
player_y2 = 300
player_forward2 = 0
player2 = GameObject("player2.png", player_x2, player_y2, 100, 150)

# Початковий напрямок для гравця 2 (дивиться наліво)
player2.image = player2.image_left
player2.facing_right = False

start = True
winner_message = ""

while start:
    screen.blit(background, (0, 0))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            start = False 
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_d:
                player_forward = 3 
            if event.key == pygame.K_a:
                player_forward = -3
            if event.key == pygame.K_w:
                player.jump()
            if event.key == pygame.K_RIGHT:
                player_forward2 = 3
            if event.key == pygame.K_LEFT:
                player_forward2 = -3
            if event.key == pygame.K_UP:
                player2.jump()

        if event.type == pygame.KEYUP:
            if event.key in (pygame.K_d, pygame.K_a):
                player_forward = 0  
            if event.key in (pygame.K_RIGHT, pygame.K_LEFT):
                player_forward2 = 0  

    player.apply_gravity()
    player.move(player_forward)
    player2.apply_gravity()
    player2.move(player_forward2)

    # --- ЛОГІКА АТАКИ ТА ЗІТКНЕНЬ ---
    if player.rect.colliderect(player2.rect):
        # Хто доторкнувся (рухається або в стрибку), той і наносить урон
        p1_active = (player_forward != 0 or player.isJumping)
        p2_active = (player_forward2 != 0 or player2.isJumping)

        if p1_active and not p2_active and player.can_hit:
            player2.hp -= 10
            player.can_hit = False
            player2.can_hit = False
        elif p2_active and not p1_active and player2.can_hit:
            player.hp -= 10
            player.can_hit = False
            player2.can_hit = False
        elif p1_active and p2_active and player.can_hit:
            # Якщо обидва бігли/стрибали назустріч — урон отримують обидва
            player.hp -= 10
            player2.hp -= 10
            player.can_hit = False
            player2.can_hit = False
    else:
        # Відновлюємо можливість атакувати, коли гравці розійшлися
        player.can_hit = True
        player2.can_hit = True

    # Перевірка умови перемоги
    if player.hp <= 0 or player2.hp <= 0:
        if player.hp > player2.hp:
            winner_message = "Виграв гравець 1"
        elif player2.hp > player.hp:
            winner_message = "Виграв гравець 2"
        else:
            winner_message = "Нічия!"
        start = False

    # Малювання гравців
    player.draw()
    player2.draw()

    # --- ВІДОБРАЖЕННЯ ТЕКСТУ HP ---
    hp_text1 = font.render(f"Гравець 1: {player.hp} HP", True, (255, 255, 255))
    hp_text2 = font.render(f"Гравець 2: {player2.hp} HP", True, (255, 255, 255))
    
    screen.blit(hp_text1, (20, 20))                           # Верхній лівий кут
    screen.blit(hp_text2, (WIDTH - hp_text2.get_width() - 20, 20)) # Верхній правий кут

    pygame.display.flip()
    clock.tick(100)

pygame.quit()

# Вивід результату в термінал
if winner_message:
    print(winner_message)
