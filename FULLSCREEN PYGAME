import pygame
from random import randint

pygame.init()

WIDTH, HEIGHT = 1200, 800
screen = pygame.display.set_mode((WIDTH, HEIGHT))
background = pygame.image.load("background.png")
background = pygame.transform.scale(background, (WIDTH, HEIGHT))
clock = pygame.time.Clock()


# 1. Добавление класса для платформ (наследует от GameObject)
class Platform(pygame.sprite.Sprite):
    def __init__(self, x, y, width, height, filename):
        super().__init__()
        self.image = pygame.image.load(filename)
        self.image = pygame.transform.scale(self.image, (width, height))
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
    
    def draw(self):
        screen.blit(self.image, self.rect)


# 2. Изменение класса GameObject для проверки столкновений
class GameObject():
    def __init__(self, filename, x=0, y=0, width=10, height=10):
        self.image_right = pygame.image.load(filename)
        self.image_right = pygame.transform.scale(self.image_right, (width, height))
        self.image_left = pygame.transform.flip(self.image_right, True, False)
        self.image = self.image_right
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.facing_right = True
    def draw(self):
        screen.blit(self.image, self.rect)

    def move(self, dx):
        self.rect.x += dx
        if dx > 0:
            self.image = self.image_right
            self.facing_right = True
        elif dx < 0:
            self.image = self.image_left
            self.facing_right = False


# 3. Параметры и создание объектов (добавляем платформы)
start = True

player_x = 0
player_y = 450
player_idle_x = 0
player_idle_y = 0
player1 = GameObject("player.png", player_x, player_y, 80, 80)

# Создаем список с платформами
platforms = []
#                          x       y     width    height   картинка платформи
platforms.append(Platform(500,    350,    200,      50,     "platform.png")) # Первая платформа

platforms.append(Platform(800, 250, 250, 50, "platform.png")) # Вторая платформа
platforms.append(Platform(800, 250, 250, 50, "platform.png")) # Вторая платформа

# 4. Цикл программы (добавляем отрисовку платформ)
while start:
    screen.blit(background, (0,0))
    
    for platform in platforms:
        platform.draw()

    player1.draw()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            start = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_RIGHT:
                player_idle_x = 5
            if event.key == pygame.K_LEFT:
                player_idle_x = -5
            if event.key == pygame.K_UP:
                player_idle_y = -5
            if event.key == pygame.K_DOWN:
                player_idle_y = 5

        if event.type == pygame.KEYUP:
            if event.key in (pygame.K_RIGHT, pygame.K_LEFT):
                player_idle_x = 0
            if event.key in (pygame.K_UP, pygame.K_DOWN):
                player_idle_y = 0

    
    player1.move(player_idle_x)
    player1.move(player_idle_y)
    
    pygame.display.flip()
    clock.tick(60)
pygame.quit()
